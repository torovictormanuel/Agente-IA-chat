# Inmobiliaria Demo — Variables de entorno
# Copia este archivo como .env y llena tus datos:
#   cp .env.example .env
# NUNCA subas el archivo .env a GitHub.

# ── Google Gemini ────────────────────────────────────────────
# Obtener gratis en: https://aistudio.google.com/apikey (sin tarjeta)
GEMINI_API_KEY=

# Modelo a usar. Verificá el nombre exacto disponible en tu cuenta en
# aistudio.google.com — Google libera modelos nuevos seguido.
GEMINI_MODEL=gemini-2.5-flash

# ── Proveedor de WhatsApp ──────────────────────────────────
# Opciones: meta | twilio — Twilio para el sandbox de prueba gratis
# (no requiere verificar un Business de Meta), Meta para producción.
WHATSAPP_PROVIDER=twilio

# ── Meta Cloud API (si WHATSAPP_PROVIDER=meta) ────────────
# META_ACCESS_TOKEN=
# META_PHONE_NUMBER_ID=
# META_VERIFY_TOKEN=agentkit-verify
# META_APP_SECRET=

# ── Twilio (si WHATSAPP_PROVIDER=twilio) ──────────────────
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=

# ── Servidor ──────────────────────────────────────────────
PORT=8000
ENVIRONMENT=development

# ── Base de datos ─────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./agentkit.db
